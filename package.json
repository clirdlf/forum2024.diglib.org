{
  "name": "dlf-forum-2024-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static archive of DLF Forum 2024, built with Eleventy",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "eleventy --serve --port=8080",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "verify": "node scripts/verify.mjs",
    "capture": "node scripts/capture.mjs",
    "normalize": "node scripts/normalize.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm test && pnpm build && pnpm verify",
    "check:pages": "node scripts/check-pages.mjs",
    "images:generate": "node scripts/generate-images.mjs",
    "images:check": "node scripts/check-images.mjs",
    "audit:a11y": "pnpm build && node scripts/a11y-preview.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^7.0.0",
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.10"
  }
}
